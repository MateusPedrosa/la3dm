<launch>
    <!-- Records sonar PointCloud2 scans (bridged from ROS 2) as numbered .pcd files
         suitable for replay with la3dm_static.launch.

         Usage:
           roslaunch la3dm pcd_recorder.launch dataset:=sonar_run1
         Then Ctrl-C when done. The node prints the final scan_num to set in the dataset YAML.
    -->

    <param name="/use_sim_time" value="true"/>

    <arg name="dataset"      default="sonar_run"/>
    <arg name="data_dir"     value="$(find la3dm)/data/$(arg dataset)"/>
    <arg name="record_rate"  default="0.5"/>
    <arg name="cloud_topic"  default="/sonar_point_cloud"/>
    <arg name="fixed_frame"  default="map"/>
    <arg name="sensor_frame" default="sonar_link"/>

    <node pkg="la3dm" type="pcd_recorder" name="pcd_recorder" output="screen">
        <param name="dir"          value="$(arg data_dir)"/>
        <param name="prefix"       value="$(arg dataset)"/>
        <param name="cloud_topic"  value="$(arg cloud_topic)"/>
        <param name="fixed_frame"  value="$(arg fixed_frame)"/>
        <param name="sensor_frame" value="$(arg sensor_frame)"/>
        <param name="record_rate"  value="$(arg record_rate)"/>
    </node>

</launch>

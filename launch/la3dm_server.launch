<launch>
    <!-- la3dm_server -->
    <!-- Sets up an la3dm node with parameters specified by args -->
    <!-- See la3dm/config/methods/bgkoctomap.yaml for config parameters -->

    <!-- odom -> ned_origin: NED/ENU convention (yaw=pi/2, roll=pi), mirrors oculus_full_setup_launch.py -->
    <!-- Published here directly to avoid ros1_bridge /tf_static QoS latching issues -->
    <!-- <node pkg="tf" type="static_transform_publisher" name="odom_to_ned_origin"
          args="0 0 0 1.5708 0 3.14159 odom ned_origin 100"/> -->

    <!-- Gemini 1200ikd -->
    <!-- <node pkg="tf" type="static_transform_publisher" name="camera_to_sonar_link"
          args="0 -0.05 -0.05 0 1.5708 -1.5708 stereo_left sonar_link 100" output="screen"/> -->

    <!-- <node pkg="tf" type="static_transform_publisher" name="camera_to_sonar_link"
          args="0 -0.35 0.0 1.5708 1.5708 0.0 camera_link sonar_link 100" output="screen"/> -->

      <!-- bluerov ECHO -->
      <node pkg="tf" type="static_transform_publisher" name="camera_to_sonar_link"
          args="0.3 0.0 0.3 0.0 0.174533 0.0 base_link sonar_link 100" output="screen"/>

    <param name="/use_sim_time" value="true"/>

    <arg name="method" default="bgklvoctomap"/>
    <arg name="method_config" value="$(find la3dm)/config/methods"/>

    <!-- Visualization publish rate (Hz). Decoupled from the sonar callback so map
         updates stay at sonar rate. Set to 0 to disable viz entirely. -->
    <arg name="viz_rate" default="1.5"/>

    <!--Start the LA3DM node -->
    <!-- <node pkg="la3dm" type="$(arg method)_server" name="la3dm_server" launch-prefix="gdb -ex run -_-args" output="screen"> -->
    <node pkg="la3dm" type="$(arg method)_server" name="la3dm_server" output="screen">

        <!-- Load method configuration from file -->
        <rosparam file="$(arg method_config)/$(arg method)_large_map.yaml" command="load"/>

        <param name="viz_rate" value="$(arg viz_rate)"/>

    </node>

</launch>
